MONGO_URI=your_mongodb_connection_string
PORT=5000
JWT_SECRET=change_this_secret
APP_BASE_URL=http://swaptome-api.onrender.com

# Gmail SMTP for real email delivery
SMTP_SERVICE=gmail
SMTP_USER=yourgmailaddress@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=yourgmailaddress@gmail.com

# Alternate aliases supported by the server
# EMAIL_SERVICE=gmail
# EMAIL_USER=yourgmailaddress@gmail.com
# EMAIL_PASS=your_gmail_app_password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Or use a direct SMTP connection URL
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# Optional if you prefer host/port instead of SMTP_SERVICE
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
